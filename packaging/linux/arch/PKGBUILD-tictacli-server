# Maintainer: CodeAlchemy-Labs <maintainers@codealchemy-labs.example>
pkgname=tictacli-server
# Placeholder. build-arch.fish overwrites this with the version from
# Cargo.toml before invoking makepkg. Do not rely on this value being
# current; it exists only to satisfy `makepkg --printsrcinfo`.
pkgver=0.3.1
pkgrel=1
pkgdesc="TicTacToe WebSocket server"
arch=('x86_64' 'aarch64')
url="https://github.com/CodeAlchemy-Labs/tictactoe-rs"
license=('MIT')
depends=('gcc-libs' 'glibc' 'ca-certificates')
makedepends=('cargo' 'rust' 'nasm')
options=('!lto' '!debug')
source=("tictacli-$pkgver.tar.gz")
# SKIP is safe here: build-arch.fish produces the tarball from the local
# repository and passes --skipinteg to makepkg. The tarball never leaves
# this machine before it is consumed.
sha256sums=('SKIP')
install=tictacli-server.install

build() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  cargo build --release --locked --bin tictacli-server
}

check() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  cargo test --release --locked -p server
}

package() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  install -Dm755 target/release/tictacli-server "$pkgdir/usr/bin/tictacli-server"
  install -Dm644 packaging/linux/common/tictacli-server.1 "$pkgdir/usr/share/man/man1/tictacli-server.1"
  install -Dm644 packaging/linux/common/tictacli-server.service "$pkgdir/usr/share/doc/tictacli-server/systemd/tictacli-server.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
