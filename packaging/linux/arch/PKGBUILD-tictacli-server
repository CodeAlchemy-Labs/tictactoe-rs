# Maintainer: CodeAlchemy-Labs <maintainers@codealchemy-labs.example>
pkgname=tictacli-server
pkgver=0.2.0
pkgrel=1
pkgdesc="TicTacToe WebSocket server"
arch=('x86_64' 'aarch64')
url="https://github.com/CodeAlchemy-Labs/tictactoe-rs"
license=('MIT')
depends=('gcc-libs' 'glibc' 'ca-certificates')
makedepends=('cargo' 'rust' 'nasm')
source=("tictacli-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP') # TODO(packaging): replace SKIP before submitting to AUR
install=tictacli-server.install

build() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  cargo build --release --locked --bin server
}

check() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  cargo test --release --locked -p server
}

package() {
  cd "tictactoe-rs-$pkgver" || cd "$srcdir"
  install -Dm755 target/release/server "$pkgdir/usr/bin/tictacli-server"
  install -Dm644 packaging/linux/common/tictacli-server.1 "$pkgdir/usr/share/man/man1/tictacli-server.1"
  install -Dm644 packaging/linux/common/tictacli-server.service "$pkgdir/usr/share/doc/tictacli-server/systemd/tictacli-server.service"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
