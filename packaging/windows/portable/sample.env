# TicTacToe Server configuration
#
# Copy the lines you need into a .env file next to tictacli-server.exe,
# or set them in the environment before launching the server.

# Deployment mode: "development" or "production".
# Default: development.
# TICTACTOE_ENV=production

# Bind address. Default: 0.0.0.0:8080.
# TICTACTOE_BIND=0.0.0.0:8080

# Global session cap. Default: 10000.
# TICTACTOE_MAX_SESSIONS=10000

# Per-IP session cap. Default: 10 in production, 10000 in development.
# TICTACTOE_MAX_SESSIONS_PER_IP=10

# Per-IP auth rate limit, in requests per minute.
# Default: 10 in production, 1000 in development.
# TICTACTOE_AUTH_RATE_LIMIT_PER_MINUTE=10

# Log level. Default: info.
# RUST_LOG=info
