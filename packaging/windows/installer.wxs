<!--
  Build with:
  wix build installer.wxs -d AppVersion=0.2.0 -o ..\..\dist\windows\tictacli-0.2.0.msi

  Requires WiX Toolset v4 (pinned to 4.0.5). Install with:
  dotnet tool install -g wix (version 4.0.5)
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package Name="TicTacToe Client"
           Manufacturer="CodeAlchemy-Labs"
           Version="$(var.AppVersion)"
           UpgradeCode="C16D360F-F63F-4AF0-95DE-63B0FE5C4151"
           Scope="perMachine">

    <MajorUpgrade DowngradeErrorMessage="A newer version of TicTacToe Client is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Application icon shown in Add/Remove Programs -->
    <Icon Id="AppIcon" SourceFile="tictacli.ico" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon" />

    <!-- License shown in the UI wizard -->
    <WixVariable Id="WixUILicenseRtf" Value="LICENSE.rtf" />

    <!-- Use the minimal WiX UI (shows licence, progress, finish) -->
    <ui:WixUI Id="WixUI_Minimal" />

    <!-- ═══════════════════════════ Install folder ═══════════════════════════ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="TicTacToe Client">

        <!-- Main executable -->
        <Component Id="ClientExeComponent" Guid="{A1B2C3D4-0001-0001-0001-000000000001}">
          <File Id="ClientExe"
                Source="..\..\target\x86_64-pc-windows-msvc\release\tictacli.exe"
                KeyPath="yes" />
        </Component>

        <!-- Application icon file (needed by shortcuts) -->
        <Component Id="IconComponent" Guid="{A1B2C3D4-0001-0001-0002-000000000001}">
          <File Id="AppIcoFile"
                Source="tictacli.ico"
                KeyPath="yes" />
        </Component>

        <!-- Post-install readme -->
        <Component Id="ReadmeComponent" Guid="{A1B2C3D4-0001-0001-0003-000000000001}">
          <File Id="ReadmeTxt"
                Source="readme-after-install.txt"
                KeyPath="yes" />
        </Component>

      </Directory>
    </StandardDirectory>

    <!-- ════════════════════════ Start Menu shortcut ════════════════════════ -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="StartMenuDir" Name="TicTacToe Client">
        <Component Id="StartMenuShortcutComponent" Guid="{A1B2C3D4-0001-0002-0001-000000000001}">
          <Shortcut Id="StartMenuShortcut"
                    Name="TicTacToe Client"
                    Description="Launch TicTacToe Client"
                    Target="[INSTALLFOLDER]tictacli.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="AppIcon"
                    Advertise="no" />
          <!-- KeyPath: registry value that tracks whether this component is installed -->
          <RegistryValue Root="HKCU"
                         Key="Software\CodeAlchemy-Labs\TicTacToe"
                         Name="StartMenuInstalled"
                         Type="integer"
                         Value="1"
                         KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- ═══════════════════════ Desktop shortcut ═══════════════════════════ -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcutComponent" Guid="{A1B2C3D4-0001-0003-0001-000000000001}">
        <Shortcut Id="DesktopShortcut"
                  Name="TicTacToe Client"
                  Description="Launch TicTacToe Client"
                  Target="[INSTALLFOLDER]tictacli.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="AppIcon"
                  Advertise="no" />
        <RegistryValue Root="HKCU"
                       Key="Software\CodeAlchemy-Labs\TicTacToe"
                       Name="DesktopInstalled"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <!-- ═══════════════════════════ Feature tree ════════════════════════════ -->
    <Feature Id="MainFeature" Title="TicTacToe Client" Level="1">
      <ComponentRef Id="ClientExeComponent" />
      <ComponentRef Id="IconComponent" />
      <ComponentRef Id="ReadmeComponent" />
      <ComponentRef Id="StartMenuShortcutComponent" />
      <ComponentRef Id="DesktopShortcutComponent" />
    </Feature>

  </Package>
</Wix>
